{
  "name": "@mikoychinese/pi-extensions-repo",
  "private": true,
  "description": "Compatibility tests for a curated Pi extension set.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikoyChinese/pi-extensions.git"
  },
  "workspaces": [
    "extensions/statusline",
    "extensions/pi-ssh-remote"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack:statusline": "npm pack --workspace @mikoychinese/pi-statusline --dry-run",
    "pack:ssh-remote": "npm pack --workspace @mikoychinese/pi-ssh-remote --dry-run",
    "pack:check": "npm run pack:statusline && npm run pack:ssh-remote"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@juicesharp/rpiv-ask-user-question": "2.10.1",
    "@tintinweb/pi-tasks": "0.9.0",
    "jiti": "^2.7.0",
    "pi-cc-extensions": "0.8.71",
    "pi-mcp-adapter": "2.33.0",
    "pi-simple-permissions": "1.0.3",
    "pi-smart-fetch": "0.3.17",
    "pi-smart-web-search": "0.4.0",
    "typebox": "^1.1.34"
  }
}
